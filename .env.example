# Telegram Bot Token — get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GMGN OpenAPI key — apply at https://gmgn.ai/ai
GMGN_API_KEY=your_gmgn_api_key_here

# Ed25519 private key for swap/order signing (optional — only needed for trading)
# Generate with:
#   openssl genpkey -algorithm ed25519 -out /tmp/gmgn_private.pem
#   openssl pkey -in /tmp/gmgn_private.pem -pubout   # paste public key on gmgn.ai
# Then store the private key as a single line with \n separating each line:
# GMGN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nABC123...\n-----END PRIVATE KEY-----"
GMGN_PRIVATE_KEY=
